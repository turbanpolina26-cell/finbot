# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Convex Configuration
VITE_CONVEX_URL=https://your-project.convex.cloud

# Netlify Web App URL (for links in bot messages)
WEB_APP_URL=https://your-netlify-app.netlify.app

# Target Chat ID for notifications (optional, can be set via /start command)
TARGET_CHAT_ID=your_telegram_chat_id_here
